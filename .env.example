# Required: your Resend API key from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional: defaults to Resend's test sender (only works sending to your own email)
# To send from a custom address, verify your domain at resend.com/domains
FROM_ADDRESS=onboarding@resend.dev

# Port (Railway sets this automatically)
PORT=8000
